{"sym":"NDX1.DE","v":2,"about":{"summary":"Nordex SE, together with its subsidiaries, develops, manufactures, and distributes multi-megawatt onshore wind turbines in Europe, North America, Latin America, and internationally. It operates in Projects and Services segments. The company offers Delta4000 and Delta series turbine platforms. It also provides project development; maintenance and repair; spare parts; remote monitoring services for wind farms; upgrades; and technical and efficiency enhancements for existing turbines. Nordex SE was incorporated in 1985 and is headquartered in Hamburg, Germany with a production facility in Izmir, Türkiye.","lead":"Nordex SE, together with its subsidiaries, develops, manufactures, and distributes multi-megawatt onshore wind turbines in Europe, North America, Latin America, and internationally. It operates in Projects and Services segments.","web":"https://www.nordex-online.com","emp":12376,"city":"Hamburg","country":"Germany"},"officers":[{"n":"Mr. Jose Luis Blanco Diéguez","t":"Chairman of Management Board & CEO","age":55,"yb":1970,"pay":1843100,"fy":2025},{"n":"Dr. Ilya Hartmann Ph.D.","t":"CFO & Member of Management Board","age":52,"yb":1973,"pay":1394100,"fy":2025},{"n":"Anja Siehler","t":"Head of Investor Relations","fy":2025},{"n":"Mr. Ralf Peters","t":"Head of Corporate Communications","fy":2025},{"n":"Mr. Kumar Manav Sharma","t":"Chief Executive Officer of North America","age":44,"yb":1981,"fy":2025},{"n":"Mr. John McComas","t":"Chief Operating Officer of North America","fy":2025},{"n":"Mr. Ibrahim Oezarslan","t":"Chief Commercial Officer","fy":2025}],"gov":{"audit":5,"board":7,"comp":7,"rights":1,"overall":8,"d":"2026-11-01"},"own":{"ins":47.0,"inst":42.58,"inst_float":80.34,"inst_n":323},"funds":[{"n":"AMERICAN FUNDS INSURANCE SERIES-Eupac Fund","pct":1.19,"pos":2819200,"val":116150000,"chg":1738.7,"d":"2026-09-30"},{"n":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.78,"pos":1851900,"val":