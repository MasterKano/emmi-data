{"sym":"LUG.TO","v":2,"about":{"summary":"Lundin Gold Inc., together with its subsidiaries, develops and operates its mineral concessions in Ecuador. It explores for gold and silver deposits. The company holds interests in 27 metallic mineral concessions and 3 construction material concessions covering an area of approximately 65,000 hectares located in Ecuador. It also holds a 100% interest in the Fruta del Norte gold project that comprising seven concessions covering an area of approximately 5,566 hectares located in the Cordillera del Cóndor region of southeast Ecuador. The company was formerly known as Fortress Minerals Corp. and changed its name to Lundin Gold Inc. in December 2014. Lundin Gold Inc. was incorporated in 1986 and is headquartered in Vancouver, Canada.","lead":"Lundin Gold Inc., together with its subsidiaries, develops and operates its mineral concessions in Ecuador. It explores for gold and silver deposits.","web":"https://lundingold.com","city":"Vancouver","state":"BC","country":"Canada"},"officers":[{"n":"Mr. James A. Beck M.B.A., P.Eng.","t":"President, CEO & Director","age":48,"yb":1977,"pay":1009100,"fy":2025},{"n":"Mr. Chester See","t":"Chief Financial Officer","pay":866550,"fy":2025},{"n":"Mr. Terrence F. D. Smith P.Eng.","t":"Chief Operating Officer","age":48,"yb":1977,"pay":847500,"fy":2025},{"n":"Mr. Brendan Creaney","t":"Vice President of Corporate Development & Investor Relations","pay":638920,"fy":2025},{"n":"Ms. Sheila Margaret Colman L.L.B.","t":"Vice President of Legal and Sustainability","age":57,"yb":1968,"pay":703670,"fy":2025},{"n":"Mr. Andre Oliveira P.Geo.","t":"Vice President of Exploration","pay":542420,"fy":2025}],"gov":{"audit":5,"board":9,"comp":2,"rights":7,"overall":6,"d":"2026-11-01"},"own":{"ins":58.49,"inst":24.53,"inst_float":59.09,"inst_n":320},"inst":[{"n":"Pacer Advisors, Inc.","pct":0.07,"pos":165510,"val":16296000,"chg":393966.6,"d":"2026-06-30"},{"n":"Ativo Capital Management, LLC","pct":0.01,"pos":26720,"va